# Copie para `.env` (nao versionado).

# Porta do host onde a app fica exposta (o container sempre escuta em 8501).
QUALITY_PORT=8502

# O banco SQLite fica num volume Docker nomeado (quality-data), definido em
# docker-compose.yml — nao precisa configurar nada aqui para isso.
# Fora do Docker, o caminho do arquivo .db pode ser ajustado em db_config.json
# (copie de db_config.json.example) ou pela variavel QUALITY_DB_PATH.
